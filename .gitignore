# Standard python ignores
*.egg-info
.coverage
.ipynb_checkpoints
**/__pycache__/
.python-version
*.pyc
**/build

# Ignore these macos generated files
.DS_Store

# Ignore these Windows generated files
*Zone.Identifier

# Ignore VS Code generated files
*.vscode

# Raw data
raw_data/
*.csv
*.sqlite
*.zip

# Data in the package
# Add files you want to include in the git repo using `git add -f file_name`
data/

# Saved models
models/
*.joblib
*.h5

# Any pickle files
*.pickle
*.pckl
*.pkl

# Credentials (or files with potentially credentials inside)
.env
.env.yaml
.credentials
secrets.toml
# GCP service-account keys and other credential JSON (scoped — a blanket
# *.json rule also hides legitimate config files, so only ignore key-like ones)
*-key.json
*-keyfile.json
*credentials*.json
service-account*.json
gcp-*.json

# Notebook scratch artifacts (intermediate models / configs dumped next to a notebook)
notebooks/*.json

#Claude
.claude/

# User defined extras
# Complete to your desire
